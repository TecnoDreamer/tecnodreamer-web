# URL pública do site, usada em metadata (Open Graph), sitemap.xml e robots.txt.
# Opcional na Vercel: se não definida, o site usa automaticamente o domínio
# de produção que a Vercel injeta (VERCEL_PROJECT_PRODUCTION_URL). Defina
# manualmente apenas quando tiver um domínio próprio configurado.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Formulário de contato (envio por e-mail via Resend) -------------------
# Guia completo em docs/DEPLOY.md. NUNCA commite valores reais: configure-os
# no painel da Vercel (Settings → Environment Variables) ou num .env.local.
#
# Chave de API criada no painel do Resend (começa com "re_").
RESEND_API_KEY=
# Quem recebe as mensagens do formulário. Com o remetente de teste do Resend
# (onboarding@resend.dev), este precisa ser o e-mail da própria conta Resend.
CONTACT_TO_EMAIL=
# Remetente. Opcional; padrão: "TecnoDreamer <onboarding@resend.dev>".
# Depois de verificar um domínio no Resend, use algo como
# "TecnoDreamer <contato@seudominio.com.br>".
CONTACT_FROM_EMAIL=
# Defina como "log" para só validar e registrar (sem enviar e-mail). Em
# desenvolvimento, sem chave configurada, isso já é o comportamento padrão;
# em produção sem chave o formulário responde 503 de propósito.
CONTACT_DELIVERY_MODE=
